# Ignore node_modules folder
node_modules/

# npm's package-lock.json is tracked for reproducible installs.
yarn.lock

# Ignore log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore environment files
.env
.env.*.local

# Ignore test result directories
coverage/

# Ignore IDE specific files
.vscode/
.idea/

# Ignore operating system files
.DS_Store
Thumbs.db

# 12-factor config: keep real environment files out of Git
.env
.env.*
!.env.example
